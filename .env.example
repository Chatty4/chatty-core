# Local development values. Copy to .env and adjust: cp .env.example .env
# Deployments set these as real environment variables instead of using a .env file.

DEBUG=True
SECRET_KEY=change-me
CORE_SERVICE_TOKEN=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the core-db service in chatty-infra/.env.example
DATABASE_URL=postgres://core_user:core_pass@127.0.0.1:5432/core_db

# Matches the Redis service in chatty-infra/docker-compose.yml
REDIS_URL=redis://127.0.0.1:6379/0

# True only behind chatty-web's Nginx, which sets X-Real-IP (D-09). Keep False locally.
BEHIND_PROXY=False

JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

APP_URL=http://127.0.0.1:5173

# Matches the minio service and chatty-core's MinIO user in chatty-infra (D-14). Outside Docker
# both URLs are the same; in Docker the internal one is http://minio:9000.
# chatty-infra's setup.bat replaces MINIO_SECRET_KEY with the secret from chatty-infra/.env.
MINIO_INTERNAL_URL=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=chatty-core
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=chatty
